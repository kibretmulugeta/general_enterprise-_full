# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME="Enterprise Auth Framework"
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/enterprise_auth

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=super_secret_access_key_enterprise_2026_change_me_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_key_enterprise_2026_change_me_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security
COOKIE_SECRET=enterprise_cookie_secret_key_987654321
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# SMTP / Email Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
EMAIL_FROM="Enterprise Auth <noreply@enterprise.local>"

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME_MINUTES=15
